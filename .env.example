# Public URLs, exactly as the browser sees them (no trailing slash)
FRONTEND_PUBLIC_URL=https://reviews.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com

# Keycloak admin console login (master realm)
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=keycloak-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Secret the API uses to grant the RESTAURANT_OWNER role (generate: openssl rand -hex 32)
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Password for the first application admin (username: admin). Only used when the realm is first imported.
INITIAL_ADMIN_PASSWORD=change-me

# Nominatim requires a contact in the User-Agent
GEOCODING_USER_AGENT=restaurant-review-platform/1.0 (you@example.com)
